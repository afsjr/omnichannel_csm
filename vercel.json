{
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist",
  "framework": "vite",
  "functions": {
    "api/**/*.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/register", "destination": "/api/register.js" },
    { "source": "/api/login", "destination": "/api/login.js" },
    { "source": "/api/users/:path*", "destination": "/api/users.js" },
    { "source": "/api/auth/:path*", "destination": "/api/auth/index.js" },
    { "source": "/api/:path*", "destination": "/api/:path*.js" }
  ]
}